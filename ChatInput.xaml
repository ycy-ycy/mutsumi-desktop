<Window x:Class="Mutsumi.Desktop.ChatInput" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:ClassModifier="internal"
        Title="和若叶睦说话" SizeToContent="Height" Width="368" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" AllowsTransparency="True" Background="Transparent"
        FontFamily="Microsoft YaHei UI" WindowStartupLocation="Manual" UseLayoutRounding="True">
  <Grid>
    <Border x:Name="Card" Background="#FFF9F7F2" BorderBrush="#9CA99B" BorderThickness="1"
          Padding="12,8,10,11" CornerRadius="11">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid x:Name="Header" Margin="0,0,0,6">
        <TextBlock x:Name="Heading" VerticalAlignment="Center" Foreground="#39443F" FontSize="13" FontWeight="SemiBold"/>
        <Button HorizontalAlignment="Right" Width="24" Height="23" Content="×" FontSize="16" Foreground="#60665F"
                Background="Transparent" BorderThickness="0" ToolTip="收起（Esc）" AutomationProperties.Name="收起"
                Click="Dismiss"/>
      </Grid>
      <TextBox x:Name="Answer" Grid.Row="1" Visibility="Collapsed" Margin="0,1,0,10" Padding="2,0,4,0"
               MaxHeight="242" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
               FontSize="14" Foreground="#28352C" BorderThickness="0" Background="Transparent"
               AutomationProperties.Name="上一条回复"/>
      <TextBlock x:Name="Notice" Grid.Row="1" Visibility="Collapsed" Foreground="#28352C" FontSize="13"
                 TextWrapping="Wrap" MaxWidth="236"/>
      <TextBlock x:Name="SwitchLine" Grid.Row="2" Visibility="Collapsed" Margin="2,0,2,8"
                 Foreground="#49574E" FontSize="13" TextWrapping="Wrap"/>
      <Grid x:Name="Composer" Grid.Row="3">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border BorderBrush="#B8BCB1" BorderThickness="1" CornerRadius="5" Background="#FFFEFC" Padding="6,4">
          <TextBox x:Name="Entry" MinHeight="24" MaxLines="5" AcceptsReturn="True" TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Center" FontSize="13"
                   Background="Transparent" BorderThickness="0" InputMethod.IsInputMethodEnabled="True"
                   AutomationProperties.Name="输入问题" ToolTip="Enter 发送，Shift+Enter 换行" TextChanged="OnTextChanged"/>
        </Border>
        <Button x:Name="Send" Grid.Column="1" Content="发送" Margin="7,0,0,0" Padding="10,2" MinHeight="32" VerticalAlignment="Bottom" FontSize="12"
                Background="#E2E8DE" BorderThickness="0" Foreground="#28352C" Click="Submit" IsEnabled="False"/>
      </Grid>
    </Grid>
    </Border>
    <Canvas IsHitTestVisible="False">
      <Polyline x:Name="Tail" Fill="{Binding Background, ElementName=Card}" Stroke="{Binding BorderBrush, ElementName=Card}"
                StrokeThickness="1" StrokeLineJoin="Round"/>
    </Canvas>
  </Grid>
</Window>

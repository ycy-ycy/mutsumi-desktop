<Window x:Class="Mutsumi.Desktop.PetWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal" Title="幕间 · 睦桌宠" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True"
        Background="{x:Null}" ShowInTaskbar="False" ShowActivated="False" WindowStartupLocation="Manual"
        Width="224" Height="288" Left="0" Top="0" UseLayoutRounding="True">
  <Viewbox Stretch="Fill">
    <Grid Width="224" Height="288" ClipToBounds="True">
      <Grid x:Name="ArtLayer" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform><TransformGroup>
          <ScaleTransform x:Name="ShelfMirror"/>
          <RotateTransform x:Name="ShelfTurn"/>
          <TranslateTransform x:Name="ShelfSlide"/>
        </TransformGroup></Grid.RenderTransform>
      <Image x:Name="Doll" Width="180" Height="240" VerticalAlignment="Bottom" Margin="0,0,0,5"
             RenderTransformOrigin="0.50,0.975" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"
             AutomationProperties.Name="桌宠角色" Cursor="Hand">
        <Image.RenderTransform><TransformGroup>
          <RotateTransform x:Name="Lean"/>
          <TranslateTransform x:Name="Lift"/>
        </TransformGroup></Image.RenderTransform>
      </Image>
      <Canvas x:Name="Effects" IsHitTestVisible="False" ClipToBounds="True"/>
      </Grid>
      <Border x:Name="Bubble" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0"
              Background="#F8F5EF" BorderBrush="#AFB5A8" BorderThickness="1" CornerRadius="11,11,11,2"
              Padding="12,6" Visibility="Collapsed" IsHitTestVisible="False">
        <TextBlock x:Name="Speech" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="184"/>
      </Border>
    </Grid>
  </Viewbox>
</Window>
